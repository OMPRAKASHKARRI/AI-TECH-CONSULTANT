# Primary provider: Groq. Keep keys private and never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096

# Optional providers: anthropic, ollama, or offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.2

# Database path is relative to the repository root unless absolute.
DATABASE_PATH=data/jd4.sqlite3
KNOWLEDGE_API_URL=http://127.0.0.1:8000
